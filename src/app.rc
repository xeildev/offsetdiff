#include <windows.h>
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "xeil"
      VALUE "FileDescription", "xeil / offsetdiff"
      VALUE "FileVersion", "0.1.0"
      VALUE "ProductName", "xeil / offsetdiff"
      VALUE "ProductVersion", "0.1.0"
      VALUE "LegalCopyright", "Copyright (c) 2026 xeil. MIT License."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
